{
  "manifest_version": 3,
  "name": "Highlight Keeper",
  "version": "1.6.0",
  "minimum_chrome_version": "116",
  "description": "網頁畫重點神器。支援 AI 自動標記、摘要筆記、指引閱讀、翻譯附註，搭配顏色分類、標籤管理與跨頁搜尋，讓閱讀更有效率。",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "clipboardRead", "sidePanel", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "highlight-selection": {
      "suggested_key": { "default": "Ctrl+Shift+H", "mac": "Command+Shift+H" },
      "description": "畫重點（選取文字後按）"
    },
    "open-reading-guide": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "開啟閱讀導覽側欄"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "開啟側邊欄"
    }
  },
  "action": {
    "default_title": "Highlight Keeper",
    "default_icon": {
      "16": "Icon/16.png",
      "32": "Icon/32.png",
      "48": "Icon/48.png"
    }
  },
  "icons": {
    "16": "Icon/16.png",
    "32": "Icon/32.png",
    "48": "Icon/48.png",
    "128": "Icon/128.png",
    "400": "Icon/Icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "parsers.js", "i18n.js", "highlightDom.js", "contentScript.js"],
      "css": ["contentStyles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "Icon/16.png",
        "Icon/32.png",
        "Icon/48.png",
        "Icon/128.png",
        "Icon/Icon.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
